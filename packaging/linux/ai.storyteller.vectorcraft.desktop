[Desktop Entry]
Type=Application
Name=VectorCraft
GenericName=Vector Graphics Editor
GenericName[pt_BR]=Editor de Gráficos Vetoriais
Comment=Draw and edit vector illustrations, SVG and PDF
Comment[pt_BR]=Crie e edite ilustrações vetoriais, SVG e PDF
Exec=/home/matosjp/.local/bin/vectorcraft %F
TryExec=/home/matosjp/.local/bin/vectorcraft
Icon=ai.storyteller.vectorcraft
Terminal=false
StartupNotify=true
StartupWMClass=ai.storyteller.vectorcraft
Categories=Graphics;2DGraphics;VectorGraphics;
Keywords=vector;illustration;svg;pdf;drawing;bezier;vetorial;ilustracao;
# MimeType lists the formats File › Open reads that Info.plist.in declares for macOS. The type of .ai
# files is shared-mime-info's application/illustrator (brand-ok).
MimeType=image/svg+xml;application/pdf;application/x-vectorcraft;image/svg+xml-compressed;application/illustrator;application/x-ai-template;image/png;image/jpeg;image/gif;image/webp;image/tiff;image/bmp;application/x-vectorcraft-template;image/vnd.dxf;image/emf;image/wmf;image/x-eps;application/x-affinity;
